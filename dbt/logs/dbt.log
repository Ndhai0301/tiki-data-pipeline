  create  table "tiki"."gold"."fact_price_daily__dbt_tmp"
  
  
    as
  
  (
    -- Grain: (product_id, dt, hour) - 1 dong = gia tri do duoc cua 1 san pham
-- tai 1 lan crawl. Dedupe bang distinct on vi 1 san pham co the xuat hien
-- o nhieu category trong cung 1 lan crawl (VD tai nghe ban trong category
-- may-tinh-bang) - Silver da dedupe theo category, chua dedupe xuyen category.

select distinct on (product_id, dt, hour)
    product_id,
    dt,
    hour,
    price,
    list_price,
    discount,
    discount_rate,
    rating_average,
    review_count,
    quantity_sold,
    inventory_status,
    badge_count,
    page,
    crawled_at
from "tiki"."staging"."stg_listings"
order by product_id, dt, hour, category_slug
  );
  
